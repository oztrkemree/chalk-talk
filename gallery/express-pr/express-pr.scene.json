  "steps": [
    {
      "title": "A chunked response",
      "say": "A client asks for `/`. The handler, from the test this PR adds, sets **Transfer-Encoding: chunked** itself before sending.",
      "show": [
        "req"
      ],
      "flow": [
        "req"
      ],
      "focus": [
        "handler"
      ]
    },
    {
      "title": "Always measure",
      "say": "`res.send('hello')` now **always** measures the body. Before this PR, a Transfer-Encoding header skipped the whole block and `len` stayed undefined.",
      "show": [
        "call"
      ],
      "flow": [
        "call"
      ],
      "focus": [
        "measure"
      ],
      "notes": [
        {
          "on": "measure",
          "text": "'hello' becomes a Buffer",
          "side": "bottom"
        }
      ]
    },
    {
      "title": "Content-Length stays out",
      "say": "The header check moved down so it guards only `Content-Length`. HTTP forbids sending it next to Transfer-Encoding, so it is still skipped.",
      "show": [
        "guard"
      ],
      "flow": [
        "guard"
      ],
      "notes": [
        {
          "on": "cl",
          "kind": "tag",
          "text": "skipped",
          "tone": "warn"
        }
      ]
    },
    {
      "title": "The ETag is back",
      "say": "With `len` defined, `etagFn` hashes the 5 bytes into a **weak ETag**. Before the fix, chunked responses never got one.",
      "show": [
        "hash",
        "send"
      ],
      "flow": [
        "hash"
      ],
      "focus": [
        "etag"
      ],
      "notes": [
        {
          "on": "etag",
          "text": "W/\"5-qvTG…\": weak by default",
          "side": "right"
        }
      ]
    },
    {
      "title": "Revalidation can work",
      "say": "`req.fresh` compares that ETag with the client's `If-None-Match`. On a repeat visit they match, so `res.send` answers **304**.",
      "show": [
        "check"
      ],
      "flow": [
        "check"
      ],
      "focus": [
        "fresh"
      ]
    },
    {
      "title": "The answer",
      "say": "`res.end` sends 200 with the ETag. A 304 goes out empty, with Content-Type and Transfer-Encoding stripped.",
      "show": [
        "reply"
      ],
      "flow": [
        "reply"
      ],
      "focus": [
        "client"
      ]
    },
    {
      "title": "One moved if",
      "say": "Measure, guard, hash, compare, answer. Moving one `if` from the length block to the header brought caching back for chunked responses.",
      "recap": true,
      "flow": [
        "req",
        "call",
        "guard",
        "hash",
        "check",
        "reply"
      ]
    }
