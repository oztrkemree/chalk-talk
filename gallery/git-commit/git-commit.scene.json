      "calls": "parse_and_write_reflog(refs, update, lock, err)" }
  ],
  "steps": [
    {
      "title": "You run git commit",
      "say": "`git.c` maps the word *commit* to `cmd_commit`. Your file contents are already in `.git/objects`: `git add` stored them as blobs.",
      "show": ["run"],
      "flow": ["run"]
    },
    {
      "title": "Lock the staging area",
      "say": "The index lists every staged path with its blob id. `cmd_commit` takes `index.lock`, so no other git command can stage mid-commit.",
      "show": ["lock"],
      "flow": ["lock"],
      "focus": ["index"]
    },
    {
      "title": "One tree per folder",
      "say": "`cache_tree_update` folds that flat list into **tree objects**, one per folder. Folders you didn't touch keep their cached id and are skipped.",
      "show": ["fold", "wtree"],
      "flow": ["fold", "wtree"],
      "notes": [{ "on": "objects", "text": "file name = hash of content", "side": "bottom" }]
    },
    {
      "title": "The commit object",
      "say": "`commit_tree_extended` writes a few lines of text: root `tree`, `parent`, author, committer, then your message. Its hash is the commit id.",
      "show": ["build", "wcommit"],
      "flow": ["build", "wcommit"],
      "focus": ["cobj"]
    },
    {
      "title": "Write once, by hash",
      "say": "Each object is zlib-compressed into a temp file, then hard-linked (or renamed) to `objects/ab/cdef…`. Same bytes, same name: a known object is never rewritten.",
      "flow": ["wcommit"],
      "focus": ["objects"],
      "notes": [{ "on": "objects", "text": "exists already? only touch mtime", "side": "bottom" }]
    },
    {
      "title": "Move the branch",
      "say": "A ref transaction updates `HEAD`, which points at your branch. The new id goes into the branch's `.lock` file, only if it still holds the old parent.",
      "show": ["move", "wref"],
      "flow": ["move", "wref"],
      "focus": ["branch"]
    },
    {
      "title": "Leave a trail",
      "say": "Before the lock is renamed into place, git appends one line to the reflogs of HEAD and the branch: old id, new id, who, when.",
      "show": ["wlog"],
      "flow": ["wlog"],
      "notes": [{ "on": "reflog", "text": "what git reflog reads", "side": "top" }]
    },
    {
      "title": "The whole write",
      "say": "Objects first, the branch last. So a branch only ever points at a commit whose trees are already on disk.",
      "recap": true,
      "flow": ["run", "lock", "fold", "wtree", "build", "wcommit", "move", "wref", "wlog"]
    }
  ]
}
