  "steps": [
    {
      "title": "The model asks",
      "say": "The model never touches your machine. It streams back a `function_call` named `exec_command`; Codex decides whether and how to run it.",
      "show": ["call"],
      "flow": ["call"],
      "focus": ["turn"]
    },
    {
      "title": "Routed by name",
      "say": "The turn loop wraps the item as a `ToolCall`. The registry finds `exec_command` by name and starts it while the stream keeps going.",
