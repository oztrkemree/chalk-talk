  "steps": [
    {
      "title": "One ASGI call",
      "say": "The server calls your `FastAPI` object as `app(scope, receive, send)`. That single call is the whole contract between them.",
      "show": [
        "asgi"
      ],
      "flow": [
        "asgi"
      ],
      "focus": [
        "app"
      ]
    },
    {
      "title": "Through the middleware",
      "say": "Starlette runs the middleware stack: error handler, your middleware, exception handlers. The router is innermost, so middleware sees every request first.",
      "show": [
        "mw"
      ],
      "flow": [
        "mw"
      ],
      "notes": [
        {
          "on": "mw",
          "text": "stack built on the first request"
        }
      ]
    },
    {
      "title": "Finding the route",
      "say": "The router tries each route's path regex in order. The first full match wins and its `path_params` are copied into the scope.",
      "show": [
        "match"
      ],
      "flow": [
        "match"
      ],
      "focus": [
        "router"
      ],
      "notes": [
        {
          "on": "router",
          "text": "path fits, method doesn't: 405",
          "side": "top"
        }
      ]
    },
    {
      "title": "Dependencies first",
      "say": "The handler reads the body, then `solve_dependencies` walks the `Depends` tree, running each sub-dependency before whatever needs it.",
      "show": [
        "solve"
      ],
      "flow": [
        "solve"
      ],
      "focus": [
        "deps"
      ],
      "notes": [
        {
          "on": "deps",
          "text": "use_cache: one call per request",
          "side": "right"
        }
      ]
    },
    {
      "title": "Strings become types",
      "say": "Path, query, header, cookie and body values each pass through a **Pydantic** `TypeAdapter`. Errors are collected, so a bad request gets one 422 listing them all.",
      "show": [
        "validate"
      ],
      "flow": [
        "validate",
        {
          "edge": "validate",
          "reverse": true,
          "packet": "42"
        }
      ],
      "focus": [
        "pyd"
      ],
      "notes": [
        {
          "on": "pyd",
          "text": "any error: your code never runs",
          "tone": "warn",
          "side": "top"
        }
      ]
    },
    {
      "title": "Your function, finally",
      "say": "Only now is your endpoint called, with arguments already typed. A plain `def` runs in a threadpool so it can't block the event loop.",
      "show": [
        "call",
        "ret"
      ],
      "flow": [
        "call",
        "ret"
      ],
      "focus": [
        "endpoint"
      ]
    },
    {
      "title": "Back out as JSON",
      "say": "`serialize_response` checks the return value against the response model, if there is one, and turns it into JSON. The response then `send`s it to the server.",
      "show": [
        "wrap",
        "send"
      ],
      "flow": [
        "wrap",
        "send"
      ],
      "focus": [
        "resp"
      ],
      "notes": [
        {
          "on": "resp",
          "text": "with a response model: plain Response",
          "side": "bottom"
        },
        {
          "on": "serialize",
          "text": "model set: Pydantic dump_json",
          "side": "top"
        }
      ]
    },
    {
      "title": "The whole trip",
      "say": "One ASGI call, one route match, dependencies, validation, your function, JSON out. Every arrow but the first is traced to a line of code.",
      "recap": true,
      "flow": [
        "asgi",
        "mw",
        "match",
        "solve",
        "validate",
        "call",
        "ret",
        "wrap",
        "send"
      ]
    }
  ]
