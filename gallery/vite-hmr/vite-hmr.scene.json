  "steps": [
    {
      "title": "You hit save",
      "say": "The dev server watches your project with **chokidar**, so the moment the editor writes the file, Vite gets its path.",
      "show": [
        "save"
      ],
      "flow": [
        "save"
      ]
    },
    {
      "title": "Forget the old result",
      "say": "`onFileChange` sets that module's cached `transformResult` to null. The next request for it must run the plugins again.",
      "show": [
        "invalidate"
      ],
      "flow": [
        "invalidate"
      ],
      "notes": [
        {
          "on": "graph",
          "text": "plus importers that don't accept it",
          "side": "bottom"
        }
      ]
    },
    {
      "title": "Hand it to HMR",
      "say": "`handleHMRUpdate` checks what changed first: a config or `.env` file restarts the server instead of patching the page.",
      "show": [
        "notify"
      ],
      "flow": [
        "notify"
      ],
      "focus": [
        "hmr"
      ]
    },
    {
      "title": "Find the boundary",
      "say": "`propagateUpdate` climbs the importers until a module accepts the change. If it reaches a module nobody imports, the page reloads.",
      "show": [
        "propagate"
      ],
      "flow": [
        "propagate",
        {
          "edge": "propagate",
          "reverse": true,
          "packet": "boundary"
        }
      ],
      "notes": [
        {
          "on": "hmr",
          "kind": "tag",
          "text": "dead end: full-reload",
          "tone": "warn"
        }
      ]
    },
    {
      "title": "One message out",
      "say": "The boundaries leave as one `update` JSON message, sent to every open tab on the `vite-hmr` WebSocket. No code travels yet.",
      "show": [
        "send",
        "push"
      ],
      "flow": [
        "send",
        "push"
      ]
    },
    {
      "title": "Fetch the fresh module",
      "say": "The client re-imports the accepted path with a new `?t=` stamp. A new URL is a new ES module, so the browser can't reuse the old one.",
      "show": [
        "server",
        "fetch"
      ],
      "flow": [
        "fetch",
        {
          "edge": "fetch",
          "reverse": true,
          "packet": "fresh JS"
        }
      ],
      "notes": [
        {
          "on": "transform",
          "text": "re-runs plugins: cache was cleared",
          "side": "bottom"
        }
      ]
    },
    {
      "title": "Swap it in",
      "say": "`fetchUpdate` hands the new module to each matching `hot.accept` callback. Only the chain up to the boundary re-runs; the rest of the page keeps its state.",
      "show": [
        "browser",
        "run"
      ],
      "flow": [
        "run"
      ],
      "focus": [
        "accept"
      ]
    },
    {
      "title": "The whole trip",
      "say": "Watch, invalidate, propagate, notify, re-import, accept. Click any arrow to see the line of Vite that makes the hop.",
      "recap": true,
      "flow": [
        "save",
        "invalidate",
        "notify",
        "propagate",
        "send",
        "push",
        "fetch",
        "run"
      ]
    }
  ]
