      "kicker": "THE BIG IDEA",
      "headline": "A vaccine is a *practice run.*",
      "sub": "Your body meets a harmless copy of a germ's shape, and remembers it.",
      "caption": "Short answer: your immune system **learns safely first**, so it's ready when the real virus shows up.",
      "notes": "Give the answer first. The rest of the lesson shows how the body pulls it off."
    },
    {
      "lens": "moment",
      "kicker": "MEET LEO",
      "set": "office",
      "shot": "wide",
      "people": [
        {
          "who": "ana",
          "pose": "stand",
          "mood": "happy",
          "at": "center-left",
          "say": "Quick pinch, all done!"
        },
        {
          "who": "leo",
          "pose": "stand",
          "mood": "surprised",
          "at": "center-right",
          "think": "What's inside that?"
        }
